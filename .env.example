# Copy to .env and fill in. Values also settable in the Cloudflare dashboard
# (Worker → Settings → Variables) for the deployed site.

# ── Nuxt Studio (GitHub OAuth app) ──────────────────────────────────────────
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=

# ── SEO (@nuxtjs/seo) ───────────────────────────────────────────────────────
# Canonical production URL — drives sitemap.xml, robots.txt and canonical tags.
NUXT_PUBLIC_SITE_URL=https://petanque-fouesnantaise.fr

# ── NuxtHub remote storage (optional, for local dev) ────────────────────────
# hub.remote (nuxt.config.ts) connects `nuxt dev` to the DEPLOYED R2 so Studio
# media listing/preview works locally (plain dev has no BLOB binding).
# PROJECT_URL = deployed worker URL. SECRET_KEY must be identical here and on
# the deployed worker (`wrangler secret put NUXT_HUB_PROJECT_SECRET_KEY`).
# Generate a value with: openssl rand -hex 32
NUXT_HUB_PROJECT_URL=
NUXT_HUB_PROJECT_SECRET_KEY=

# ── Images (R2 + Cloudflare Image Transformations) ──────────────────────────
# Public domain of the R2 bucket (ptank-images) that serves /images/**. The
# image originals are NOT bundled in the deploy (they live in /image-sources
# only to upload from), so this is REQUIRED to see images anywhere — dev
# included (unless you rely on the default). In prod the edge additionally resizes them; in dev the originals
# load straight from R2.
# Live value: https://image.petanque-fouesnantaise.fr  (also the built-in default)
NUXT_IMAGE_R2_BASE=

# Public domain used to SERVE media that editors upload through Studio (stored
# in the same R2 bucket under the images/ prefix, via NuxtHub blob). Normally
# the SAME value as NUXT_IMAGE_R2_BASE, which is what it falls back to. It MUST
# be absolute: Studio's ipx proxy treats a relative media path as a filesystem
# path and 404s every thumbnail in the media tab.
S3_PUBLIC_URL=

# ── Cloudflare Access service token (local dev only) ────────────────────────
# Lets `nuxt dev` bind the REAL R2 bucket ("remote": true in wrangler.jsonc), so
# the media tab browses production's images and local uploads land in the
# production bucket. Wrangler's remote proxy connects to
# ptank.gab-2-blois.workers.dev, which Access gates, and it has no TTY to log in
# with — without these it falls back to a stub and dev gets NO bindings at all.
# Create: Zero Trust → Access → Service Auth → Service Tokens → Create, then add
# a policy on that application with action "Service Auth" including the token.
# Never needed by the deployed Worker.
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=

# ── Analytics (optional) ────────────────────────────────────────────────────
# Cloudflare Web Analytics beacon token — free and cookieless (no consent banner
# required). Get it from Cloudflare → Analytics & Logs → Web Analytics → add a
# site. Leave empty and no beacon is injected at all.
NUXT_PUBLIC_CF_BEACON_TOKEN=
